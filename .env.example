# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى GitHub أبداً.
# أنشئ مفتاح API بصلاحية "Spot Trading" فقط — عطّل صلاحية السحب (Withdrawals).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# استخدم شبكة Binance التجريبية (testnet.binance.vision) بدل الحساب الحقيقي
BINANCE_TESTNET=true

# التداول الحقيقي يتطلب هذا المتغير = true بالإضافة إلى الخيار --live في سطر الأوامر
LIVE_TRADING=false

SYMBOL=BTC/USDT
TIMEFRAME=1h

# الاستراتيجية: تقاطع متوسطين أسيين مع فلتر RSI
FAST_EMA=12
SLOW_EMA=26
RSI_PERIOD=14
RSI_MAX_ENTRY=70

# إدارة المخاطر
RISK_PER_TRADE=0.01        # نسبة رأس المال المعرّضة للخسارة في الصفقة الواحدة (1%)
ATR_PERIOD=14
STOP_ATR_MULT=2.0          # وقف الخسارة = سعر الدخول - 2 × ATR
TAKE_PROFIT_ATR_MULT=4.0   # جني الربح = سعر الدخول + 4 × ATR
MAX_POSITION_PCT=0.25      # أقصى حجم للمركز كنسبة من رأس المال
MAX_DAILY_LOSS_PCT=0.03    # يتوقف البوت عن فتح صفقات جديدة بعد خسارة 3% في اليوم

# التداول الورقي (Paper)
PAPER_STARTING_BALANCE=1000
FEE_RATE=0.001             # عمولة Binance الافتراضية 0.1%
SLIPPAGE=0.0005

POLL_SECONDS=60
